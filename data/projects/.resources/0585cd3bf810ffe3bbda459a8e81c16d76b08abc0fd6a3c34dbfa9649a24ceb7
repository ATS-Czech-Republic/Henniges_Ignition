    "custom.range": {
      "binding": {
        "config": {
          "path": "view.params.initRange"
        },
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\tnow \t  \u003d system.date.now()\n\tnowHr \t  \u003d system.date.getHour24(now)\n\ttoday     \u003d system.date.setTime(now, 6, 0, 0)\n\trangeType \u003d currentValue.value\n\t\n\tif nowHr \u003e\u003d 6 and rangeType in (\u0027today\u0027,\u0027yesterday\u0027):\t\t# only for today, and yesterday\n\t\t# new day has already started\n\t\ttoday \u003d system.date.addDays(today, 1)\n\t#self.getSibling(\"DateTimePicker\").props.value \u003d None\n\n\tif rangeType \u003d\u003d \u0027today\u0027: #today\n\t\tnewDayS \u003d system.date.addDays(today, -1)\t\n\t\tnewDayE \u003d  (today)\t\n\telif rangeType \u003d\u003d \u0027yesterday\u0027: #yesterday\n\t\tnewDayS \u003d system.date.addDays(today, -2)\t\n\t\tnewDayE \u003d system.date.addDays(today, -1)\t\t\n\telif rangeType \u003d\u003d \u0027thisWeek\u0027: #actual week\n\t\tdaysFromMonday \u003d system.date.getDayOfWeek(today) + 5\n\t\tnewDayS \u003d system.date.addDays(today, -daysFromMonday)\n\t\tnewDayS \u003d system.date.addWeeks(newDayS,1)\n\t\tnewDayS \u003d system.date.setTime(newDayS, 6, 0, 0)\n\t\tnewDayE \u003d system.date.addWeeks(newDayS,1)\n\telif rangeType \u003d\u003d \u0027lastWeek\u0027: \n\t\tdaysFromMonday \u003d system.date.getDayOfWeek(today) + 5\n\t\tnewDayE \u003d system.date.addDays(today, -daysFromMonday)\n\t\tnewDayE \u003d system.date.addWeeks(newDayE,1)\n\t\tnewDayE \u003d system.date.setTime(newDayE, 6, 0, 0)\n\t\tnewDayS \u003d system.date.addWeeks(newDayE,-1)\n\telif rangeType \u003d\u003d \u0027thisMonth\u0027: #actual month\n\t\teyear \u003d system.date.getYear(today)\n\t\temonth \u003d system.date.getMonth(today)\n\t\tnewDayS \u003d system.date.getDate(eyear, emonth, 1)\n\t\tnewDayS \u003d system.date.setTime(newDayS, 6, 0, 0)\n\t\tnewDayE \u003d system.date.addMonths(newDayS, 1)\t\n\telif rangeType \u003d\u003d \u0027lastMonth\u0027: #actual month\n\t\teyear \u003d system.date.getYear(today)\n\t\temonth \u003d system.date.getMonth(today)\n\t\tnewDayE \u003d system.date.getDate(eyear, emonth, 1)\n\t\tnewDayE \u003d system.date.setTime(newDayE, 6, 0, 0)\n\t\tnewDayS \u003d system.date.addMonths(newDayE, -1)\t\n\telif rangeType \u003d\u003d \u0027ytd\u0027: #YTD\n\t\tsyear \u003d system.date.getYear(today)\n\t\tnewDayS \u003d system.date.getDate (syear, 0, 1)\n\t\tnewDayS \u003d system.date.setTime(newDayS, 6, 0, 0)\n\t\tnewDayE \u003d system.date.addDays(today, 1)\n\telse:\n\t\treturn\n\t\t\n\t# set start/end datetim\n\tself.params.startTime \u003d newDayS\n\tself.params.endTime \u003d newDayE\t"
      },
      "persistent": true
    },
    "params.endTime": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.initRange": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.startTime": {
      "paramDirection": "inout",
      "persistent": true
    }
  },

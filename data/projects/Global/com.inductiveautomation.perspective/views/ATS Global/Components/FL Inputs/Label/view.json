{
  "custom": {},
  "params": {
    "title": "Label",
    "value": ""
  },
  "propConfig": {
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 49,
      "width": 250
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "fl-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif currentValue.value !\u003d \u0027\u0027 and currentValue.value !\u003d None:\n\t\tself.getSibling(\"Title\").props.style.classes \u003d \"fl-label fl-label--active\"\n\telse:\n\t\tself.getSibling(\"Title\").props.style.classes \u003d \"fl-label\""
            }
          }
        },
        "props": {
          "style": {
            "classes": "fl-input",
            "minWidth": "150px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "minHeight": "50px",
        "overflow": "hidden",
        "padding": "2px",
        "position": "relative"
      }
    },
    "type": "ia.container.flex"
  }
}
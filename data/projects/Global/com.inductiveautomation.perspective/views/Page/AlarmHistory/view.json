{
  "custom": {},
  "params": {
    "UHFname": "UHF3"
  },
  "propConfig": {
    "params.UHFname": {
      "binding": {
        "config": {
          "path": "session.custom.LineName"
        },
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.feature": {
      "paramDirection": "input"
    },
    "params.tier1": {
      "paramDirection": "input"
    },
    "params.tier2": {
      "paramDirection": "input"
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "56px",
          "shrink": 0
        },
        "props": {
          "params": {
            "icon": "history",
            "text": "Hisorie alarmů"
          },
          "path": "Page/Embedded/Title"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "AlarmJournalTable"
        },
        "position": {
          "basis": "400px",
          "grow": 1
        },
        "propConfig": {
          "props.filter.conditions.provider": {
            "binding": {
              "config": {
                "path": "view.params.UHFname"
              },
              "type": "property"
            }
          },
          "props.name": {
            "binding": {
              "config": {
                "expression": "\"AJ_\"+{view.params.UHFname}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "columns": {
            "displayPath": {
              "enabled": true
            },
            "eventId": {
              "enabled": false
            },
            "eventState": {
              "strictWidth": true
            },
            "eventTime": {
              "sort": "descending",
              "strictWidth": true
            },
            "label": {
              "enabled": true,
              "width": 200
            },
            "priority": {
              "strictWidth": true
            },
            "source": {
              "enabled": false
            }
          },
          "dateFormat": "DD.MM.YYYY HH:mm:ss",
          "dateRange": {
            "historical": {
              "endDate": {
                "$": [
                  "ts",
                  0,
                  1780079684066
                ],
                "$ts": 1780079672989
              },
              "startDate": {
                "$": [
                  "ts",
                  0,
                  1780079684066
                ],
                "$ts": 1780050872988
              }
            }
          },
          "filter": {
            "conditions": {}
          },
          "pager": {
            "initialOption": 50
          },
          "style": {
            "classes": "Page/Alarm/Alarm"
          }
        },
        "type": "ia.display.alarmjournaltable"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignContent": "flex-start",
      "direction": "column",
      "style": {
        "classes": "Page/Alarm/Page Page/Page"
      }
    },
    "type": "ia.container.flex"
  }
}
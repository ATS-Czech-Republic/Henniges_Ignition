{
  "custom": {},
  "params": {
    "UHFname": "UHF3",
    "key": "UHF3"
  },
  "propConfig": {
    "params.UHFname": {
      "binding": {
        "config": {
          "path": "session.custom.LineName"
        },
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.feature": {
      "paramDirection": "input"
    },
    "params.tier1": {
      "paramDirection": "input"
    },
    "params.tier2": {
      "paramDirection": "input"
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "56px",
          "shrink": 0
        },
        "props": {
          "params": {
            "icon": "alarm",
            "text": "Aktivní alarmy"
          },
          "path": "Page/Embedded/Title"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "AlarmStatusTable"
        },
        "position": {
          "basis": "400px",
          "grow": 1
        },
        "propConfig": {
          "props.filters.active.conditions.provider": {
            "binding": {
              "config": {
                "path": "view.params.UHFname"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "columns": {
            "active": {
              "activeTime": {
                "sort": "descending",
                "strictWidth": true
              },
              "label": {
                "enabled": true,
                "order": 2,
                "width": 200
              },
              "name": {
                "order": 5
              },
              "priority": {
                "order": 3,
                "strictWidth": true,
                "width": 100
              },
              "source": {
                "enabled": false
              },
              "state": {
                "order": 4
              }
            }
          },
          "dateFormat": "DD.MM.YYYY HH:mm:ss",
          "filters": {
            "active": {
              "conditions": {}
            }
          },
          "pager": {
            "initialOption": 50
          },
          "style": {
            "classes": "Page/Alarm/Alarm"
          }
        },
        "type": "ia.display.alarmstatustable"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignContent": "flex-start",
      "direction": "column",
      "style": {
        "classes": "Page/Alarm/Page Page/Page"
      }
    },
    "type": "ia.container.flex"
  }
}
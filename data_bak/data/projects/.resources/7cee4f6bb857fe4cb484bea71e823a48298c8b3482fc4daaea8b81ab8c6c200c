{
  "custom": {},
  "params": {
    "title": "Text Field",
    "value": ""
  },
  "propConfig": {
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 49,
      "width": 250
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "fl-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onBlur": {
              "config": {
                "script": "\tval \u003d self.props.text\n\tif not val:\n\t    self.getSibling(\"Title\").props.style.classes \u003d \"fl-label\""
              },
              "scope": "G",
              "type": "script"
            },
            "onFocus": {
              "config": {
                "script": "\tself.getSibling(\"Title\").props.style.classes \u003d \"fl-label fl-label--active\""
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "TextField"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value"
              },
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif currentValue.value !\u003d \u0027\u0027 and currentValue.value !\u003d None:\n\t\tself.getSibling(\"Title\").props.style.classes \u003d \"fl-label fl-label--active\"\n\telse:\n\t\tself.getSibling(\"Title\").props.style.classes \u003d \"fl-label\""
            }
          }
        },
        "props": {
          "deferUpdates": false,
          "rejectUpdatesWhileFocused": false,
          "style": {
            "classes": "fl-input"
          }
        },
        "type": "ia.input.text-field"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "minHeight": "50px",
        "overflow": "hidden",
        "padding": "2px",
        "position": "relative"
      }
    },
    "type": "ia.container.flex"
  }
}